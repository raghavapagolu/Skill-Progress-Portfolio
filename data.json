          "studentName": "Mahith",
          "studentAvatar": "MH",
          "question": "What is the fastest way to align nested cards with Auto-Layout without breaking spacing?",
          "createdAt": "2026-11-06 16:15",
          "status": "answered",
          "replies": [
            {
              "id": 303,
              "authorName": "Sarah (Mentor)",
              "isMentor": true,
              "text": "Always set the parent frame to Auto-Layout (Shift + A), then set children to 'Fill Container' horizontally. That way padding remains consistent across different device sizes!",
              "createdAt": "2026-11-06 17:00"
            }
          ]
        }
      ]
