          "replies": [
            {
              "id": 1794128509126,
              "authorName": "Hemanth (Mentor)",
              "isMentor": true,
              "text": "You can define grid-template-areas with named zones and rearrange them inside media queries!",
              "createdAt": "2026-11-08 09:01"
            }
          ]
        },
        {
          "id": 201,
          "studentName": "Raghava",
          "studentAvatar": "RG",
          "question": "When should I use CSS Grid instead of Flexbox for page layouts?",
          "createdAt": "2026-11-06 14:20",
          "status": "answered",
          "replies": [
            {
              "id": 301,
              "authorName": "Hemanth (Mentor)",
              "isMentor": true,
              "text": "Great question! Flexbox is 1-dimensional (row OR column), ideal for navbars or card content. CSS Grid is 2-dimensional (rows AND columns simultaneously), ideal for whole-page layouts.",
              "createdAt": "2026-11-06 15:05"
            },
            {
              "id": 1794128688776,
              "authorName": "Raghava",
              "isMentor": false,
              "text": "hi",
              "createdAt": "2026-11-08 09:04"
            }
          ]
        },
        {
          "id": 202,
          "studentName": "Meera",
          "studentAvatar": "MR",
          "question": "How do media queries handle mobile screens with high pixel density?",
          "createdAt": "2026-11-07 10:45",
          "status": "answered",
          "replies": [
            {
              "id": 302,
              "authorName": "Hemanth (Mentor)",
              "isMentor": true,
              "text": "Media queries look at CSS viewport pixels, not hardware device pixels, so a 390px mobile viewport triggers the mobile breakpoint regardless of retina 3x pixel ratio.",
              "createdAt": "2026-11-07 11:30"
            }
          ]
        },
        {
          "id": 1794129428152,
          "studentName": "Raghava",
          "studentAvatar": "R",
